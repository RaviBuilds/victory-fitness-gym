# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in real values for each gym deployment.
# See docs/MASTER-GYM-CUSTOMIZATION-SOP.md, step 7.
#
# The inquiry form (Section 10) delivers through Resend's HTTP API from
# app/api/contact/route.ts. All three variables below are required before the
# form can send. Until they are set the endpoint answers 503 with a safe
# message and the visitor is told to use WhatsApp or phone — it never pretends
# a message was delivered.

# Resend API key. Server-side only; it must never appear in lib/*.ts, a
# component, or any NEXT_PUBLIC_ variable.
RESEND_API_KEY=

# Where inquiry-form submissions are delivered (the gym's inbox).
CONTACT_TO_EMAIL=

# Sender address for inquiry notifications. MUST be an address on a domain
# verified in the Resend account used for this deployment, otherwise Resend
# rejects the send. Accepts a bare address (the gym's name from lib/business.ts
# is attached automatically) or a pre-formatted "Gym Name <hello@gym.com>".
# Never hardcode an unverified production sender.
CONTACT_FROM_EMAIL=

# Internal Factory identifier for this deployment.
BUSINESS_ID=

# ---------------------------------------------------------------------------
# DEMO ACCESS (private-demo PIN gate) - server-side only, never NEXT_PUBLIC_.
# Remove with the gate (see proxy.ts). Both are optional overrides: the
# defaults live in config/demo-access.ts.
# ---------------------------------------------------------------------------
# Secret used to sign the access cookie. Set a long random value on Vercel.
DEMO_ACCESS_SECRET=
# Optional: override the PIN from config/demo-access.ts without a code change.
DEMO_ACCESS_PIN=


# ---------------------------------------------------------------------------
# CAMPAIGN PREVIEW (development only). Uncomment in .env.local and restart
# `next dev` to evaluate the real campaign calendar as if it were this date
# (e.g. to preview the live-campaign modal). Ignored by `next build` and
# `next start`. See lib/offer-preview.ts.
# ---------------------------------------------------------------------------
# OFFER_PREVIEW_DATE=2026-10-20
